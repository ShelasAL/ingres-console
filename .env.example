# Primary LLM Provider: openrouter | gemini | openai | custom
LLM_PROVIDER=openrouter

# OpenRouter Configuration (Primary default)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_MODEL=meta-llama/llama-3.3-70b-instruct
LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional fallback providers (can also be entered directly in the web UI sidebar)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Database path
DB_PATH=data/synthetic/ingres.duckdb
