# Uploaded to Vercel but not needed by the deployed console.
# Paths are anchored with a leading "/" so a name like "app" cannot match
# frontend/web/app (that would strip the UI from the function bundle).
/.git
/.github
/.vercel
/.dsh-plugins
/.pytest_cache
/.coverage
/__pycache__
**/__pycache__
*.pyc

# Legacy Streamlit UI (needs a long-running process; not deployable here)
/app
/.streamlit
/roomiee

# Not needed at runtime
/tests
/docs
/frontend/screenshots
/frontend/capture_console.mjs

# Documents and decks
*.pptx
*.docx
*.pdf
